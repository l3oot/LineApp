{
  "type": "bubble",
  "size": "mega",
  "body": {
    "type": "box",
    "layout": "vertical",
    "contents": [
      {
        "type": "image",
        "url": "https://lh3.googleusercontent.com/d/1wHulKh-sJsg0dHzzFXmTbRkT3b2NGfXn",
        "size": "full",
        "aspectMode": "cover",
        "aspectRatio": "20:7",
        "gravity": "center"
      },
      {
        "type": "box",
        "layout": "vertical",
        "contents": [
          {
            "type": "box",
            "layout": "horizontal",
            "contents": [
              {
                "type": "box",
                "layout": "vertical",
                "contents": [
                  {
                    "type": "text",
                    "text": "ประเภท",
                    "size": "md",
                    "color": "#818180"
                  }
                ],
                "width": "80px",
                "justifyContent": "center"
              },
              {
                "type": "box",
                "layout": "vertical",
                "contents": [
                  {
                    "type": "text",
                    "text": "{{typeLabel}}",
                    "size": "md",
                    "color": "{{typeColor}}",
                    "align": "end",
                    "weight": "bold"
                  }
                ],
                "borderWidth": "1px",
                "cornerRadius": "md",
                "justifyContent": "center",
                "paddingAll": "sm",
                "flex": 1
              }
            ],
            "alignItems": "center",
            "spacing": "sm"
          }
        ],
        "paddingStart": "xl",
        "paddingEnd": "xl",
        "paddingTop": "md"
      },
      {
        "type": "box",
        "layout": "vertical",
        "contents": [
          {
            "type": "box",
            "layout": "horizontal",
            "contents": [
              {
                "type": "box",
                "layout": "vertical",
                "contents": [
                  {
                    "type": "text",
                    "text": "รายการ",
                    "size": "md",
                    "color": "#818180"
                  }
                ],
                "width": "80px",
                "justifyContent": "center"
              },
              {
                "type": "box",
                "layout": "vertical",
                "contents": [
                  {
                    "type": "text",
                    "text": "{{main}}",
                    "size": "md",
                    "align": "end",
                    "wrap": true,
                    "maxLines": 2
                  }
                ],
                "borderWidth": "1px",
                "cornerRadius": "md",
                "justifyContent": "center",
                "paddingAll": "sm",
                "flex": 1
              }
            ],
            "alignItems": "center",
            "spacing": "sm"
          }
        ],
        "paddingStart": "xl",
        "paddingEnd": "xl",
        "paddingTop": "sm"
      },
      {
        "type": "box",
        "layout": "vertical",
        "contents": [
          {
            "type": "box",
            "layout": "horizontal",
            "contents": [
              {
                "type": "box",
                "layout": "vertical",
                "contents": [
                  {
                    "type": "text",
                    "text": "หมวดหมู่",
                    "size": "md",
                    "color": "#818180"
                  }
                ],
                "width": "80px",
                "justifyContent": "center"
              },
              {
                "type": "box",
                "layout": "vertical",
                "contents": [
                  {
                    "type": "text",
                    "text": "{{categoryName}}",
                    "size": "md",
                    "align": "end",
                    "wrap": true,
                    "maxLines": 2
                  }
                ],
                "borderWidth": "1px",
                "cornerRadius": "md",
                "justifyContent": "center",
                "paddingAll": "sm",
                "flex": 1
              }
            ],
            "alignItems": "center",
            "spacing": "sm"
          }
        ],
        "paddingStart": "xl",
        "paddingEnd": "xl",
        "paddingTop": "sm"
      },
      {
        "type": "box",
        "layout": "vertical",
        "contents": [
          {
            "type": "box",
            "layout": "horizontal",
            "contents": [
              {
                "type": "box",
                "layout": "vertical",
                "contents": [
                  {
                    "type": "text",
                    "text": "รอบ",
                    "size": "md",
                    "color": "#818180"
                  }
                ],
                "width": "80px",
                "justifyContent": "center"
              },
              {
                "type": "box",
                "layout": "vertical",
                "contents": [
                  {
                    "type": "text",
                    "text": "{{cycleName}}",
                    "size": "md",
                    "align": "end",
                    "wrap": true,
                    "maxLines": 2
                  }
                ],
                "borderWidth": "1px",
                "cornerRadius": "md",
                "justifyContent": "center",
                "paddingAll": "sm",
                "flex": 1
              }
            ],
            "alignItems": "center",
            "spacing": "sm"
          }
        ],
        "paddingStart": "xl",
        "paddingEnd": "xl",
        "paddingTop": "sm"
      },
      {
        "type": "box",
        "layout": "vertical",
        "contents": [
          {
            "type": "box",
            "layout": "horizontal",
            "contents": [
              {
                "type": "box",
                "layout": "vertical",
                "contents": [
                  {
                    "type": "text",
                    "text": "วันที่",
                    "size": "md",
                    "color": "#818180"
                  }
                ],
                "width": "80px",
                "justifyContent": "center"
              },
              {
                "type": "box",
                "layout": "vertical",
                "contents": [
                  {
                    "type": "text",
                    "text": "{{txDateTime}}",
                    "size": "md",
                    "align": "end",
                    "wrap": true,
                    "maxLines": 2
                  }
                ],
                "borderWidth": "1px",
                "cornerRadius": "md",
                "justifyContent": "center",
                "paddingAll": "sm",
                "flex": 1
              }
            ],
            "alignItems": "center",
            "spacing": "sm"
          }
        ],
        "paddingStart": "xl",
        "paddingEnd": "xl",
        "paddingTop": "sm"
      },
      {
        "type": "box",
        "layout": "vertical",
        "contents": [
          {
            "type": "box",
            "layout": "horizontal",
            "contents": [
              {
                "type": "box",
                "layout": "vertical",
                "contents": [
                  {
                    "type": "text",
                    "text": "จำนวน",
                    "size": "md",
                    "color": "#818180"
                  }
                ],
                "width": "80px",
                "justifyContent": "center"
              },
              {
                "type": "box",
                "layout": "vertical",
                "contents": [
                  {
                    "type": "text",
                    "text": "{{price}}",
                    "size": "3xl",
                    "color": "{{amountColor}}",
                    "weight": "bold",
                    "align": "end",
                    "wrap": true,
                    "maxLines": 1
                  }
                ],
                "borderWidth": "1px",
                "cornerRadius": "md",
                "justifyContent": "center",
                "paddingAll": "sm",
                "flex": 1
              }
            ],
            "alignItems": "center",
            "spacing": "sm"
          }
        ],
        "paddingStart": "xl",
        "paddingEnd": "xl",
        "paddingTop": "sm",
        "paddingBottom": "md"
      }
    ],
    "paddingAll": "0px"
  },
  "footer": {
    "type": "box",
    "layout": "horizontal",
    "contents": [
      {
        "type": "filler"
      },
      {
        "type": "box",
        "layout": "vertical",
        "contents": [
          {
            "type": "button",
            "action": {
              "type": "uri",
              "label": "แก้ไข",
              "uri": "{{editUri}}"
            },
            "style": "primary",
            "color": "#669C5B"
          }
        ],
        "justifyContent": "center",
        "cornerRadius": "lg",
        "height": "40px",
        "paddingEnd": "xs"
      },
      {
        "type": "box",
        "layout": "vertical",
        "contents": [
          {
            "type": "button",
            "action": {
              "type": "postback",
              "label": "ลบ",
              "data": "{{deleteData}}",
              "displayText": "ลบรายการ"
            },
            "style": "primary",
            "color": "#C82333"
          }
        ],
        "height": "40px",
        "justifyContent": "center",
        "cornerRadius": "lg",
        "paddingStart": "xs"
      }
    ],
    "height": "70px",
    "paddingAll": "xl"
  },
  "styles": {
    "footer": {
      "separator": true
    }
  }
}
