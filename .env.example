# คัดลอกเป็น .env ที่ root แล้วกรอกค่าตามเครื่อง
# Docker Compose อ่านไฟล์นี้เมื่อรัน `docker compose up`

# ---------- Frontend (Vite bake ตอน build) ----------
VITE_API_BASE_URL=
VITE_LINE_CHANNEL_ID=
# ต้องตรงกับ Callback URL เส้นเว็บ OAuth ใน LINE Console (รวม /callback)
VITE_LINE_REDIRECT_URI=
# LIFF ID จาก LINE Developers — ใช้ login ในแอป LINE
# Callback URL ต้องมีทั้ง {origin}/callback และ {origin}/
VITE_LIFF_ID=

# ---------- LINE Login / Messaging (user-service) ----------
LINE_CLIENT_ID=
LINE_CLIENT_SECRET=
LINE_REDIRECT_URI=
# base URL ของแอปใน Flex Message — ว่างได้ ระบบจะ derive จาก LINE_REDIRECT_URI
LINE_LIFF_URL=
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# ---------- Backend ----------
SERVER_ADDRESS=
SERVER_PORT=
APP_PUBLIC_BASE_URL=
APP_CORS_ALLOWED_ORIGINS=
DOCS_USERNAME=
DOCS_PASSWORD=
JWT_SECRET=
JWT_EXPIRATION=

# ---------- Database ----------
SPRING_DATASOURCE_URL=
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=

