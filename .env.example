# คัดลอกเป็น .env ที่ root แล้วแก้ค่าตามเครื่อง
# docker compose ที่ root จะอ่านอัตโนมัติเมื่อรัน `docker compose up`

# ---------- PostgreSQL (รันบน host เครื่อง dev) ----------
POSTGRES_DB=Lineapp
POSTGRES_USER=postgres
POSTGRES_PASSWORD=chutiman

# ---------- Spring Security ----------
# credential ที่ใช้ login HTTP Basic เพื่อเข้า /api/docs (Swagger UI) และ /v3/api-docs
DOCS_USERNAME=admin
DOCS_PASSWORD=admin

# ---------- CORS ----------
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:4173

# ---------- Frontend (Vite build args) ----------
# VITE_* จะถูก baked ลง bundle ตอน build — ถ้าเปลี่ยน ต้อง rebuild image
VITE_API_BASE_URL=http://localhost:8080
VITE_LINE_CHANNEL_ID=2009886740
VITE_LINE_REDIRECT_URI=http://localhost:5173/callback
