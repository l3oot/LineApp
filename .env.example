# คัดลอกเป็น .env ที่ root แล้วกรอกค่าตามเครื่อง/สภาพแวดล้อม
# Docker Compose ที่ root จะอ่านไฟล์นี้อัตโนมัติเมื่อรัน `docker compose up`

# ---------- Frontend ----------
VITE_API_BASE_URL=
VITE_LINE_CHANNEL_ID=
VITE_LINE_REDIRECT_URI=
VITE_LINE_LIFF_URL=

LINE_CLIENT_ID=
LINE_CLIENT_SECRET=
LINE_REDIRECT_URI=
LINE_LIFF_URL=

APP_PUBLIC_BASE_URL=

# ---------- PostgreSQL (รันบน host เครื่อง dev) ----------
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

SPRING_DATASOURCE_URL=
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=

# ---------- Spring DevTools / runtime env ----------
SPRING_DEVTOOLS_RESTART_ENABLED=
SPRING_DEVTOOLS_RESTART_POLL_INTERVAL=
SPRING_DEVTOOLS_RESTART_QUIET_PERIOD=
CHOKIDAR_USEPOLLING=
WATCHPACK_POLLING=
SERVER_ADDRESS=
SERVER_PORT=
PYTHONUNBUFFERED=
LINEAPP_API_BASE=
WATCHFILES_FORCE_POLLING=

# ---------- Spring Security ----------
# credential ที่ใช้ login HTTP Basic เพื่อเข้า /api/docs (Swagger UI) และ /v3/api-docs
DOCS_USERNAME=
DOCS_PASSWORD=

# ---------- CORS ----------
APP_CORS_ALLOWED_ORIGINS=

# ---------- LINE Messaging API (Chatbot) ----------
# Channel access token: ใส่ token จาก Messaging API tab
LINE_CHANNEL_ACCESS_TOKEN=
# Channel secret: ใส่ secret จาก Basic settings tab
LINE_CHANNEL_SECRET=
# LIFF/Web app base URL (ถ้าไม่ใส่ ระบบจะ derive จาก LINE_REDIRECT_URI)
LINE_LIFF_URL=

# ---------- AI service (FastAPI) ----------
# user-service เรียกผ่าน HTTP: GET ${AI_SERVICE_URL}${AI_PARSE_PATH}?text=...&userId=...
AI_SERVICE_URL=
AI_PARSE_PATH=
AI_WEATHER_WARNING_PATH=/weather-warning/summarize
AI_WEATHER_BRIEF_PATH=/weather-brief/summarize
AI_AGRI_PRICE_EXTRACT_PATH=/agri-price/extract
AI_AGRI_PRICE_BRIEF_PATH=/agri-price/summarize
AI_TIMEOUT_SECONDS=
# API key สำหรับ OpenTyphoon
api_key_openai=
# API key สำหรับ ThaiLLM
api_key_thaillm=

# ---------- Backend public URL (Flex static images) ----------
# URL สาธารณะของ backend (ควรเป็น HTTPS ใน production)
APP_PUBLIC_BASE_URL=

# ---------- ngrok ----------
# authtoken จาก https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=

# ---------- MOPH HCode API (จังหวัด / อำเภอ / ตำบล) ----------
# สมัครบัญชีที่ https://hcode.moph.go.th/signup/
HCODE_BASE_URL=
HCODE_USERNAME=
HCODE_PASSWORD=
HCODE_DATA_SOURCE=
HCODE_PAGE_SIZE=
HCODE_TIMEOUT_SECONDS=

# ---------- NABC agri price API ----------
AGRI_PRICE_BASE_URL=https://agriapi.nabc.go.th
AGRI_PRICE_TIMEOUT_SECONDS=20
AGRI_PRICE_MAX_PAGES=3

# ---------- TMD weather API ----------
WEATHER_API_BASE_URL=https://data.tmd.go.th/nwpapi
WEATHER_API_TOKEN=
WEATHER_API_TIMEOUT_SECONDS=20
WEATHER_API_DURATION_HOURS=24
WEATHER_WARNING_URL=https://data.tmd.go.th/api/WeatherWarningNews/v2/
WEATHER_WARNING_UID=demo
WEATHER_WARNING_UKEY=demokey
